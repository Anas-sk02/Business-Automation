# ============================================================
# SignalForge AI — Frontend Environment Variables Template
# Copy this file to frontend/.env.local and replace placeholders
# DO NOT COMMIT frontend/.env.local TO VERSION CONTROL
# Note: NEVER expose SUPABASE_SERVICE_KEY here!
# ============================================================

# Supabase Auth & Browser Client (Public Anon Key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# SignalForge AI — Backend Environment Variables Template
# Copy this file to backend/.env and replace placeholders
# DO NOT COMMIT backend/.env TO VERSION CONTROL
# ============================================================

# Supabase (PostgreSQL, Auth, Storage)
SUPABASE_URL=https://your-project.supabase.co
# Service role key has admin rights to bypass RLS in the backend. Keep private!
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Google Places API (New)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# AI Provider (gemini or claude, default: gemini)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_claude_api_key
AI_MODEL=gemini-2.5-flash

# WhatsApp Business API (Twilio only for V1 per decisions.md)
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCOUNT_SID=your_twilio_account_sid
WHATSAPP_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_FROM_NUMBER=+14155238886

# Safety & Limits
DAILY_SEND_LIMIT=50
QUIET_HOURS_START=21:00
QUIET_HOURS_END=09:00

# CORS & Server
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
